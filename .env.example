VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:4000
VITE_REQUEST_TIMEOUT_MS=5000
VITE_MOCK_ERROR_RATE=0.02
VITE_MOCK_DELAY_MIN_MS=300
VITE_MOCK_DELAY_MAX_MS=900

# ── Cognito Hosted UI — Google sign-in (PKCE flow) ───────────────────────────
VITE_COGNITO_DOMAIN=https://<cognito-domain-prefix>.auth.<region>.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<spa-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback

# Auth Service v3
VITE_AUTH_CANDIDATE_REGISTER_ENDPOINT=/api/auth-service/v1/auth/candidates/register
VITE_AUTH_CANDIDATE_VISITOR_CONVERSION_ENDPOINT=/api/auth-service/v1/auth/candidates/register/visitor/conversion
VITE_AUTH_STAFF_REGISTER_ENDPOINT=/api/auth-service/v1/auth/staff/register
VITE_AUTH_GOOGLE_REGISTER_ENDPOINT=/api/auth-service/v1/auth/candidates/register-google
VITE_AUTH_LOGIN_ENDPOINT=/api/auth-service/v1/auth/login
VITE_AUTH_FORGOT_PASSWORD_ENDPOINT=/api/auth-service/v1/auth/forgot-password
VITE_AUTH_RESET_PASSWORD_ENDPOINT=/api/auth-service/v1/auth/reset-password
VITE_AUTH_LOGOUT_ENDPOINT=/api/auth-service/v1/auth/logout
VITE_AUTH_ME_ENDPOINT=/api/auth-service/v1/users/me
VITE_AUTH_VALIDATE_ENDPOINT=/api/auth-service/v1/users/validate
VITE_STAFF_PROFILES_ENDPOINT=/api/auth-service/v1/staff/profiles
VITE_ADMIN_STAFF_INVITATIONS_SEND_ENDPOINT=/api/auth-service/v1/admin/staff-invitations/send

# Users / Profiles
VITE_USERS_PROFILE_ENDPOINT=/users/:userId
VITE_USERS_PROFILE_PHOTO_ENDPOINT=/users/:userId/profile-photo

# Candidate
VITE_CANDIDATE_LANDING_ENDPOINT=/candidates/landing
VITE_CANDIDATE_STATISTICS_ENDPOINT=/candidates/landing
VITE_CANDIDATE_DASHBOARD_ENDPOINT=/candidates/dashboard
VITE_CANDIDATE_PROFILE_ENDPOINT=/candidates/profile/:candidateId
VITE_CANDIDATE_BUILDMYCV_ENDPOINT=/candidates/cv-build/:candidateId
VITE_CANDIDATE_RESUME_PREVIEW_ENDPOINT=/candidate/:resumeId/preview
VITE_CANDIDATE_RESUME_DOWNLOAD_ENDPOINT=/candidate/:resumeId/download
VITE_CANDIDATE_RECOMMENDED_JOBS_ENDPOINT=/candidates/:candidateId/recommended-positions
VITE_CANDIDATE_SAVED_JOBS_ENDPOINT=/candidates/:candidateId/saved-jobs
VITE_CANDIDATE_SAVED_JOB_ENDPOINT=/candidates/:candidateId/saved-jobs/:jobProfileId
VITE_CANDIDATE_AI_ACTIONS_ENDPOINT=/candidates/ai-actions/
VITE_CANDIDATE_APPLICATIONS_ENDPOINT=/candidates/apply
VITE_CANDIDATE_BY_EMAIL_ENDPOINT=/candidates/by-email
VITE_APPLICATION_CV_UPLOAD_ENDPOINT=/applications/:applicationId/cv/upload

# Documents
VITE_DOCUMENTS_UPLOAD_RESUME_ENDPOINT=/documents/resume
VITE_DOCUMENTS_UPLOAD_ENDPOINT=/documents

# Mandate Service v2
VITE_JOBS_ENDPOINT=/view/jobs
VITE_JOB_DETAILS_ENDPOINT=/jobs/:jobProfileId
VITE_JOB_PROFILE_DETAILS_ENDPOINT=/jobs/:jobProfileId
VITE_JOBS_QUERY_PARAM=search
VITE_JOBS_PAGE_PARAM=page
VITE_JOBS_LIMIT_PARAM=size
VITE_DASHBOARD_SUMMARY_ENDPOINT=/dashboard/summary
VITE_COMPANIES_LIST_ENDPOINT=/companies

# Industries
VITE_INDUSTRIES_LIST_ENDPOINT=/industries

# Skills
VITE_SKILLS_SEARCH_ENDPOINT=/skills/search
VITE_SKILLS_SEARCH_KEYWORD_PARAM=keyword
VITE_SKILLS_SEARCH_LIMIT_PARAM=limit

# AI
VITE_SKILLS_GENERATE_ENDPOINT=/skills/generate

# Candidates (recruiter-facing list)
VITE_CANDIDATES_LIST_ENDPOINT=/candidates

# Recruiter
VITE_RECRUITER_DASHBOARD_ENDPOINT=/recruiter/dashboard
VITE_RECRUITER_MANDATES_ENDPOINT=/recruiter/mandates
VITE_RECRUITER_APPLICATION_STAGE_ENDPOINT=/recruiter/applications/:applicationId/stage
VITE_RECRUITER_CANDIDATES_SEARCH_ENDPOINT=/recruiter/candidates/search
VITE_MANDATE_DETAIL_ENDPOINT=/mandates/:mandateId
VITE_APPLICATION_STAGE_TRANSITION_ENDPOINT=/applications/:applicationId/stage-transition
VITE_RECRUITER_CANDIDATE_PROFILE_ENDPOINT=/v1/candidates/:candidateId/profile

# Pipeline
VITE_PIPELINE_STAGE_UPDATE_ENDPOINT=/v1/pipeline/:pipelineId/stage

# MANCO
VITE_MANCO_DASHBOARD_ENDPOINT=/v1/manco/:mancoId/dashboard
VITE_MANCO_RECRUITER_PERFORMANCE_ENDPOINT=/v1/manco/recruiters/:id/performance

# Job Posts (recruiter mandate dashboard)
VITE_JOB_POSTS_ENDPOINT=/job-posts
VITE_JOB_POST_CREATE_ENDPOINT=/job-posts
VITE_JOB_POST_DETAIL_ENDPOINT=/job-posts/:mandateId
VITE_JOB_POST_UPDATE_ENDPOINT=/job-posts/:mandateId
VITE_JOB_POST_DELETE_ENDPOINT=/job-posts/:mandateId

# CRM
VITE_CRM_CLIENTS_ENDPOINT=/v1/crm/clients
VITE_CRM_CLIENT_NOTES_ENDPOINT=/v1/crm/clients/:clientId/notes
VITE_CRM_STATUS_PARAM=status