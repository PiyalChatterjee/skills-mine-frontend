VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:4000/api
VITE_JOBS_ENDPOINT=/jobs
VITE_JOBS_QUERY_PARAM=query
VITE_JOBS_PAGE_PARAM=page
VITE_JOBS_PAGE_SIZE_PARAM=pageSize
VITE_JOBS_LIMIT_PARAM=limit
VITE_AUTH_LOGIN_ENDPOINT=/auth/login
VITE_AUTH_SIGNUP_ENDPOINT=/auth/signup
VITE_RECRUITER_REGISTER_ENDPOINT=/recruiters/register
VITE_AUTH_ME_ENDPOINT=/auth/me
VITE_AUTH_LOGOUT_ENDPOINT=/auth/logout
VITE_REQUEST_TIMEOUT_MS=5000
VITE_MOCK_ERROR_RATE=0.05
VITE_MOCK_DELAY_MIN_MS=500
VITE_MOCK_DELAY_MAX_MS=1500