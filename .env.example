# ── Gateway host ──────────────────────────────────────────────────────────────
# Single base URL shared by all microservices.
# Service path suffixes (/api/candidate-service, /api/mandate-service, …) are
# appended in src/services/api/axios.ts — nothing extra needed here.
VITE_API_BASE_URL=https://<api-gateway-id>.execute-api.<region>.amazonaws.com

# ── Third-party credentials ───────────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Cognito Hosted UI — Google sign-in (PKCE flow) ───────────────────────────
VITE_COGNITO_DOMAIN=https://<cognito-domain-prefix>.auth.<region>.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<spa-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:3000/callback
