VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:4000/api
VITE_REQUEST_TIMEOUT_MS=5000
VITE_MOCK_ERROR_RATE=0.02
VITE_MOCK_DELAY_MIN_MS=300
VITE_MOCK_DELAY_MAX_MS=900

# Auth
VITE_AUTH_REGISTER_ENDPOINT=/auth/register
VITE_AUTH_LOGIN_ENDPOINT=/auth/login
VITE_AUTH_FORGOT_PASSWORD_ENDPOINT=/auth/forgot-password
VITE_AUTH_CHANGE_PASSWORD_ENDPOINT=/auth/change-password
VITE_AUTH_LOGOUT_ENDPOINT=/auth/logout
VITE_AUTH_GOOGLE_EXCHANGE_ENDPOINT=/auth/google/exchange
VITE_AUTH_ME_ENDPOINT=/auth/me

# Users / Profiles
VITE_USERS_PROFILE_ENDPOINT=/users/:userId
VITE_USERS_PROFILE_PHOTO_ENDPOINT=/users/:userId/profile-photo

# Candidate
VITE_CANDIDATE_LANDING_ENDPOINT=/candidates/landing
VITE_CANDIDATE_DASHBOARD_ENDPOINT=/candidates/dashboard
VITE_CANDIDATE_PROFILE_ENDPOINT=/candidates/profile/
VITE_CANDIDATE_BUILDMYCV_ENDPOINT=/candidates/cv-build/
VITE_CANDIDATE_RESUME_PREVIEW_ENDPOINT=/candidate/:resumeId/preview
VITE_CANDIDATE_RESUME_DOWNLOAD_ENDPOINT=/candidate/:resumeId/download
VITE_CANDIDATE_RECOMMENDED_JOBS_ENDPOINT=/candidates/recommended-positions
VITE_CANDIDATE_SAVED_JOBS_ENDPOINT=/candidates/saved-jobs
VITE_CANDIDATE_AI_ACTIONS_ENDPOINT=/candidates/ai-actions/
VITE_APPLICATION_CV_UPLOAD_ENDPOINT=/applications/:applicationId/cv/upload

# Documents
VITE_DOCUMENTS_UPLOAD_RESUME_ENDPOINT=/documents/resume
VITE_DOCUMENTS_UPLOAD_ENDPOINT=/documents

# Jobs / Opportunities
VITE_JOBS_ENDPOINT=/jobs
VITE_JOB_DETAILS_ENDPOINT=/jobs/:jobId
VITE_JOB_SAVE_ENDPOINT=/jobs/:jobId/save
VITE_JOB_APPLY_ENDPOINT=/jobs/:jobId/apply
VITE_OPPORTUNITIES_ENDPOINT=/opportunities
VITE_JOBS_QUERY_PARAM=q
VITE_JOBS_PAGE_PARAM=page
VITE_JOBS_PAGE_SIZE_PARAM=pageSize
VITE_JOBS_LIMIT_PARAM=limit

# Skills
VITE_SKILLS_SEARCH_ENDPOINT=/skills/search
VITE_SKILLS_SEARCH_KEYWORD_PARAM=keyword
VITE_SKILLS_SEARCH_LIMIT_PARAM=limit

# Recruiter
VITE_RECRUITER_DASHBOARD_ENDPOINT=/recruiter/dashboard
VITE_RECRUITER_MANDATES_ENDPOINT=/recruiter/mandates
VITE_RECRUITER_APPLICATION_STAGE_ENDPOINT=/recruiter/applications/:applicationId/stage
VITE_RECRUITER_CANDIDATES_SEARCH_ENDPOINT=/recruiter/candidates/search
VITE_MANDATE_DETAIL_ENDPOINT=/mandates/:mandateId
VITE_APPLICATION_STAGE_TRANSITION_ENDPOINT=/applications/:applicationId/stage-transition
VITE_RECRUITER_CANDIDATE_PROFILE_ENDPOINT=/v1/candidates/:candidateId/profile

# Pipeline
VITE_PIPELINE_STAGE_UPDATE_ENDPOINT=/v1/pipeline/:pipelineId/stage

# MANCO
VITE_MANCO_DASHBOARD_ENDPOINT=/v1/manco/:mancoId/dashboard
VITE_MANCO_RECRUITER_PERFORMANCE_ENDPOINT=/v1/manco/recruiters/:id/performance

# CRM
VITE_CRM_CLIENTS_ENDPOINT=/v1/crm/clients
VITE_CRM_CLIENT_NOTES_ENDPOINT=/v1/crm/clients/:clientId/notes
VITE_CRM_STATUS_PARAM=status